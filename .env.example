# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai                      # openai | gemini
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Database (PostgreSQL for production) ─────────────────────────────────────
DATABASE_URL=postgresql://finai:finai_secret@localhost:5432/finai_db
# For local SQLite dev: DATABASE_URL=sqlite:///./financial_analyst.db

# ── Redis (caching + rate limiting) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-real-secret-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440         # 24 hours

# ── App Config ────────────────────────────────────────────────────────────────
APP_NAME=FinanceAI
APP_ENV=development                      # development | production
API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_HOUR=20
