FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

# Install frontend-only dependencies
RUN pip install --no-cache-dir --user \
    streamlit plotly pandas numpy httpx pydantic pydantic-settings \
    Pillow python-dotenv sqlalchemy \
    scikit-learn scipy statsmodels openpyxl xlrd \
    pdfplumber pymupdf reportlab \
    passlib[bcrypt] python-jose[cryptography] \
    openai google-generativeai

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

RUN useradd -m -u 1001 appuser
USER appuser

COPY --chown=appuser:appuser . .

# Streamlit config
RUN mkdir -p /home/appuser/.streamlit
COPY --chown=appuser:appuser .streamlit/config.toml /home/appuser/.streamlit/config.toml

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.enableCORS=false", \
     "--server.enableXsrfProtection=false"]
